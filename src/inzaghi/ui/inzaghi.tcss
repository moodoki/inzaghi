/* Inzaghi. Restrained on purpose: this screen is left open for hours, so colour
   is reserved for the two things that ever need to shout -- liveness and a
   question waiting on you. */

Screen {
    background: $surface;
}

/* -- the footer row ----------------------------------------------------- */

/* The build sits in the bottom-left corner and the keys take the rest. It is
   dim on purpose: it answers "which copy is this" when something is wrong,
   and the rest of the time it should be furniture. */
#statusbar {
    dock: bottom;
    height: 1;
}

#build {
    width: auto;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The Footer docks itself to the bottom of the screen by its own default
   stylesheet, which takes it out of this row and puts it over the build.
   Undocked, it is an ordinary child and takes the width the build leaves. */
#statusbar Footer {
    dock: none;
    width: 1fr;
}

TabbedContent {
    height: 1fr;
}

/* -- overview ---------------------------------------------------------- */

OverviewPane {
    padding: 1 2;
}

#overview-summary {
    padding: 0 0 1 0;
    color: $text-muted;
}

/* Decoration, docked out of the way and dimmed well below the data. */
#pigeon-dock {
    dock: bottom;
    height: auto;
    align-horizontal: right;
    padding: 0 2 1 0;
}

#pigeon {
    width: auto;
    height: auto;
    color: $text-muted;
    opacity: 0.45;
}

#overview-table {
    height: auto;
    max-height: 100%;
    overflow-x: hidden;
}

/* -- channel ----------------------------------------------------------- */

ChannelPane {
    height: 1fr;
}

#strip {
    padding: 0 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    height: auto;
    min-height: 1;
    border-bottom: solid $panel;
    background: $boost;
}

#filterbar {
    padding: 0 2;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#search {
    margin: 0 2;
    height: 3;
}

#channel-body {
    height: 1fr;
}

/* The left column: the log, with the draft box folded out beneath it. */
#left {
    width: 46%;
    min-width: 34;
    height: 1fr;
    border-right: solid $panel;
}

#timeline {
    /* A list of one-line entries: clip long titles rather than reflow them,
       so every row stays on the same grid -- and hold the scrollbar's column
       whether or not there is a scrollbar in it. Without that, the bar
       appearing resizes the list, a resize clears the height cache, and every
       option is measured two or three times on the way onto the screen
       instead of once. One blank column is the price of a tab switch that
       does not walk the whole channel twice over. */
    scrollbar-gutter: stable;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0 1;
    background: $surface;
}

Composer {
    height: 50%;
    min-height: 8;
    border-top: solid $primary;
    padding: 0 1;
    background: $surface;
}

#composer-head {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#compose-text {
    height: 1fr;
    border: none;
    padding: 0;
}

#timeline > .option-list--option-highlighted {
    background: $primary-darken-2;
}

#reader-column {
    width: 1fr;
    height: 1fr;
}

#reader {
    width: 1fr;
    /* Never squeezed away entirely: the strip and an opened file are both
       sized as shares of this column, and between them they can ask for more
       than there is. Whichever is at the bottom is clipped instead, which
       leaves a key to press; prose that has vanished leaves nothing. */
    height: 1fr;
    min-height: 4;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

/* Delivered files, listed under the document that announced them. Sized to
   its contents so prose keeps the room when there are none -- and it is
   hidden outright in that case. */
#attachments {
    scrollbar-gutter: stable;  /* as #timeline: measured once, not thrice */
    height: auto;
    max-height: 40%;
    border: none;
    border-top: solid $panel;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#attachments > .option-list--option-highlighted {
    background: $primary-darken-2;
}

/* A delivered text file, rendered in place rather than launched. Takes three
   quarters of the reader, since opening a file is asking to read it, and is
   dragged or keyed from there; the height is set inline by ui/preview.py, so
   this is only where it begins. */
#preview {
    height: 75%;
    min-height: 4;
    background: $surface;
}

/* Two rows, not one: the border is inside the height, and the row it leaves
   is the label saying which file this is and how to move or close it. */
#preview-grip {
    height: 2;
    padding: 0 1;
    border-top: solid $primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#preview-body {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#preview-text {
    width: 1fr;
    height: auto;
}

/* The find box: one row at the bottom of the column being searched, which is
   where vim puts it. Hidden until asked for. */
#find-bar {
    height: 1;
    background: $surface;
}

#find {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
}

/* A fixed width, not auto: beside a 1fr input, an auto sibling is sized after
   the input has already taken the row and ends up off the right edge. Wide
   enough for "no matches", which is the longest thing it says. */
#find-count {
    width: 14;
    height: 1;
    padding: 0 1;
    text-align: right;
    text-wrap: nowrap;
}

/* The lit match. A rendered document has no cursor to move through it, so
   the tint on the block is the cursor. */
MarkdownBlock.-match {
    background: $primary-darken-2;
}

/* -- modals ------------------------------------------------------------ */

ConfirmScreen {
    align: center middle;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 2;
}

#confirm-box {
    width: 68;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

PromptScreen {
    align: center middle;
    background: $background 60%;
}

#prompt-box {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#prompt-question {
    width: 100%;
    padding-bottom: 1;
}

#confirm-question {
    text-style: bold;
    padding-bottom: 1;
}

#confirm-detail {
    padding-bottom: 1;
}
