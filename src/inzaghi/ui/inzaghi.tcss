/* Inzaghi. Restrained on purpose: this screen is left open for hours, so colour
   is reserved for the two things that ever need to shout -- liveness and a
   question waiting on you. */

Screen {
    background: $surface;
}

TabbedContent {
    height: 1fr;
}

/* -- overview ---------------------------------------------------------- */

OverviewPane {
    padding: 1 2;
}

#overview-summary {
    padding: 0 0 1 0;
    color: $text-muted;
}

/* Decoration, docked out of the way and dimmed well below the data. */
#pigeon-dock {
    dock: bottom;
    height: auto;
    align-horizontal: right;
    padding: 0 2 1 0;
}

#pigeon {
    width: auto;
    height: auto;
    color: $text-muted;
    opacity: 0.45;
}

#overview-table {
    height: auto;
    max-height: 100%;
    overflow-x: hidden;
}

/* -- channel ----------------------------------------------------------- */

ChannelPane {
    height: 1fr;
}

#strip {
    padding: 0 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    height: auto;
    min-height: 1;
    border-bottom: solid $panel;
    background: $boost;
}

#filterbar {
    padding: 0 2;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#search {
    margin: 0 2;
    height: 3;
}

#channel-body {
    height: 1fr;
}

/* The left column: the log, with the draft box folded out beneath it. */
#left {
    width: 46%;
    min-width: 34;
    height: 1fr;
    border-right: solid $panel;
}

#timeline {
    /* A list of one-line entries: clip long titles rather than reflow them,
       so every row stays on the same grid. */
    text-wrap: nowrap;
    text-overflow: ellipsis;
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0 1;
    background: $surface;
}

Composer {
    height: 50%;
    min-height: 8;
    border-top: solid $primary;
    padding: 0 1;
    background: $surface;
}

#composer-head {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#compose-text {
    height: 1fr;
    border: none;
    padding: 0;
}

#timeline > .option-list--option-highlighted {
    background: $primary-darken-2;
}

#reader-column {
    width: 1fr;
    height: 1fr;
}

#reader {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

/* Delivered files, listed under the document that announced them. Sized to
   its contents so prose keeps the room when there are none -- and it is
   hidden outright in that case. */
#attachments {
    height: auto;
    max-height: 40%;
    border: none;
    border-top: solid $panel;
    padding: 0 1;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#attachments > .option-list--option-highlighted {
    background: $primary-darken-2;
}

/* -- modals ------------------------------------------------------------ */

ConfirmScreen {
    align: center middle;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 2;
}

#confirm-box {
    width: 68;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#confirm-question {
    text-style: bold;
    padding-bottom: 1;
}

#confirm-detail {
    padding-bottom: 1;
}
